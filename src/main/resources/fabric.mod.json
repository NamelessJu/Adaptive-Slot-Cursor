{
    "schemaVersion": 1,
    "id": "adaptive-slot-cursor",
    "version": "${version}",
    "name": "Adaptive Slot Cursor",
    "description": "Changes the cursor based on hovering slots or dragging items in inventories",
    "authors": ["NamelessJu"],
    "contact": {
        "sources": "https://github.com/NamelessJu/Adaptive-Slot-Cursor"
    },
    "license": "LGPL-3.0-or-later",
    "icon": "assets/adaptive-slot-cursor/icon.png",
    "environment": "client",
    "entrypoints": {
        "client": [ "namelessju.adaptiveslotcursor.AdaptiveSlotCursor" ],
        "modmenu": [ "namelessju.adaptiveslotcursor.impl.ModMenuApiImpl" ]
    },
    "mixins": [
        {
            "config": "adaptive-slot-cursor.client.mixins.json",
            "environment": "client"
        }
    ],
    "depends": {
        "fabricloader": ">=0.19.5",
        "minecraft": "${minecraft}",
        "java": ">=${java}"
    }
}
